# Casa Liva — copiez ce fichier vers .env.local et remplissez les valeurs.
# Aucune de ces clés ne doit être préfixée NEXT_PUBLIC_ sauf celles listées comme telles.

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── IA (serveur uniquement) ─────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Facultatif — les modèles, surchargeables sans redéploiement (D31, D40).
# `LIGHT` sert aux tâches où le travail difficile est déjà fait par notre
# code : le briefing reçoit une feuille de faits et n'a que deux phrases à
# en tirer. Le chat, qui choisit un tool et écrit une date, garde l'autre.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_LIGHT=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# ── Email ───────────────────────────────────────────────────
RESEND_API_KEY=

# ── Google OAuth + Calendar ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cron ────────────────────────────────────────────────────
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
